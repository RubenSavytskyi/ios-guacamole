+/* WLAN-owned, physically contiguous buffers restricted to the 32-bit
+ * address range required by legacy WMI host-memory requests.
+ * /dev/pmem already performs cache maintenance on CPU reads/writes.
+ * This is NOT an IOVA/page-table allocator: only read-only verified
+ * firmware-provided stage-1-bypass configuration may authorize it.
+ */
+static int
+pm_do_wlan_alloc(struct pmem_alloc *a)
+{
+    int permitted = 0;
+    PE_parse_boot_argn("sweetwlandma", &permitted, sizeof(permitted));
+    if (!permitted || !pm_wlan_verified) return EPERM;
+    if (a->size == 0 || a->size > 16ULL * 1024ULL * 1024ULL ||
+        a->size > (0x100000000ULL - PAGE_MASK)) return EINVAL;
+    vm_size_t size = round_page(a->size);
+    uint64_t align = a->align > PAGE_SIZE ? a->align : PAGE_SIZE;
+    if (!size || align > 0x1000000ULL || (align & (align - 1)) ||
+        size > PMEM_WLAN_TOTAL_MAX - pm_wlan_allocated) return EINVAL;
+    int slot = -1;
+    for (int i = 0; i < PMEM_WLAN_MAX_ALLOCS; i++) {
+        if (!pm_wlan_allocs[i].va) { slot = i; break; }
+    }
+    if (slot < 0) return ENOSPC;
+    vm_offset_t va = 0;
+    ppnum_t max_pnum = (ppnum_t)(atop_64(0x100000000ULL) - 1);
+    if (kmem_alloc_contig(kernel_map, &va, size, PAGE_MASK,
+            max_pnum, (ppnum_t)(atop_64(align) - 1),
+            KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS)
+        return ENOMEM;
+    ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+    if (!pn) {
+        kmem_free(kernel_map, va, size);
+        return ENOMEM;
+    }
+    uint64_t pa = ptoa_64(pn);
+    if (!pa || pa >= 0x100000000ULL ||
+        (uint64_t)size > 0x100000000ULL - pa) {
+        kmem_free(kernel_map, va, size);
+        return ERANGE;
+    }
+    flush_dcache64((addr64_t)pa, (unsigned)size, TRUE);
+    pm_wlan_allocs[slot].va = va;
+    pm_wlan_allocs[slot].pa = pa;
+    pm_wlan_allocs[slot].size = size;
+    pm_wlan_allocated += size;
+    a->pa = pa;
+    a->size = size;
+    return 0;
+}
+
+static int
+pm_do_wlan_free(uint64_t pa)
+{
+    for (int i = 0; i < PMEM_WLAN_MAX_ALLOCS; i++) {
+        if (pm_wlan_allocs[i].va && pm_wlan_allocs[i].pa == pa) {
+            kmem_free(kernel_map, pm_wlan_allocs[i].va,
+                      (vm_size_t)pm_wlan_allocs[i].size);
+            pm_wlan_allocated -= pm_wlan_allocs[i].size;
+            bzero(&pm_wlan_allocs[i], sizeof(pm_wlan_allocs[i]));
+            return 0;
+        }
+    }
+    return ENOENT;
+}
