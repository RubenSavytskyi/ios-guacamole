+/* Independent WLAN-only allocations. Never share slot/ownership with GPU PMEM.
+ * Device IOVA == CPU PA is permitted only after the firmware-installed WLAN
+ * bypass group has been verified. We do not assign or reprogram context banks.
+ */
+#define PMEM_WLAN_MAX_ALLOCS 64
+#define PMEM_WLAN_TOTAL_MAX (128ULL * 1024ULL * 1024ULL)
+#define PMEM_WLAN_ALLOC32 _IOWR('P', 9, struct pmem_alloc)
+#define PMEM_WLAN_FREE _IOW('P', 10, uint64_t)
+static struct {
+    vm_offset_t va;
+    uint64_t pa, size;
+} pm_wlan_allocs[PMEM_WLAN_MAX_ALLOCS];
+static uint64_t pm_wlan_allocated;
+static int pm_wlan_verified;
