+/*
+ * Bit-bang I2C on the pads themselves (SDA GPIO55, SCL GPIO56), open-drain
+ * style: drive low by enabling the output with a 0 latch, release by putting
+ * the pad back into input mode (pull-up stays on). The QUP is not involved, so
+ * this works no matter which mode the boot chain left SE17 in.
+ *
+ * Timing comes from mach_absolute_time(); the tick rate is derived from XNU's
+ * own absolutetime_to_nanoseconds() conversion (no clock votes needed).
+ */
+static uint64_t
+touch_bb_ticks(void)
+{
+	return mach_absolute_time();
+}
+
+static uint64_t
+touch_bb_hz(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(1000000u, &ns);
+	if (!ns) {
+		return 19200000u;
+	}
+	return 1000000000000000ull / ns;
+}
+
+static void
+touch_bb_delay(uint64_t ticks)
+{
+	uint64_t start = touch_bb_ticks();
+	while (touch_bb_ticks() - start < ticks) {
+	}
+}
+
+static void
+touch_bb_put(unsigned pin, uint32_t cfg, bool low)
+{
+	if (low) {
+		uint32_t io = touch_rd(st.gpio, TOUCH_GPIO_IO(pin));
+		touch_wr(st.gpio, TOUCH_GPIO_IO(pin), io & ~2u);
+		touch_wr(st.gpio, TOUCH_GPIO_CFG(pin), cfg | 0x200u);
+	} else {
+		touch_wr(st.gpio, TOUCH_GPIO_CFG(pin), cfg & ~0x200u);
+	}
+}
+
+/* Release SCL; a slave that stretches the clock is waited for (2 ms max). */
+static bool
+touch_bb_scl_high(void)
+{
+	uint64_t limit = st.bb_hz / 500u;
+	uint64_t start;
+
+	touch_bb_put(TP_SCL, st.bb_scl, false);
+	start = touch_bb_ticks();
+	while (!(touch_rd(st.gpio, TOUCH_GPIO_IO(TP_SCL)) & 1u)) {
+		if (touch_bb_ticks() - start > limit) {
+			return false;
+		}
+	}
+	touch_bb_delay(st.bb_half);
+	return true;
+}
+
+static bool
+touch_bb_start(void)
+{
+	touch_bb_put(TP_SDA, st.bb_sda, false);
+	touch_bb_delay(st.bb_half);
+	if (!touch_bb_scl_high()) {
+		return false;
+	}
+	touch_bb_put(TP_SDA, st.bb_sda, true);
+	touch_bb_delay(st.bb_half);
+	touch_bb_put(TP_SCL, st.bb_scl, true);
+	touch_bb_delay(st.bb_half);
+	return true;
+}
+
+static void
+touch_bb_stop(void)
+{
+	touch_bb_put(TP_SDA, st.bb_sda, true);
+	touch_bb_delay(st.bb_half);
+	(void)touch_bb_scl_high();
+	touch_bb_put(TP_SDA, st.bb_sda, false);
+	touch_bb_delay(st.bb_half);
+}
+
+static bool
+touch_bb_bit(bool one)
+{
+	touch_bb_put(TP_SDA, st.bb_sda, !one);
+	touch_bb_delay(st.bb_half);
+	if (!touch_bb_scl_high()) {
+		return false;
+	}
+	touch_bb_put(TP_SCL, st.bb_scl, true);
+	touch_bb_delay(st.bb_half);
+	return true;
+}
+
+/* -1 on a stuck clock, else the level the slave put on SDA. */
+static int
+touch_bb_read_bit(void)
+{
+	int v;
+
+	touch_bb_put(TP_SDA, st.bb_sda, false);
+	touch_bb_delay(st.bb_half);
+	if (!touch_bb_scl_high()) {
+		return -1;
+	}
+	v = (int)(touch_rd(st.gpio, TOUCH_GPIO_IO(TP_SDA)) & 1u);
+	touch_bb_put(TP_SCL, st.bb_scl, true);
+	touch_bb_delay(st.bb_half);
+	return v;
+}
+
+static int
+touch_bb_write_byte(uint8_t b)
+{
+	int ack;
+
+	for (int i = 7; i >= 0; --i) {
+		if (!touch_bb_bit(((b >> i) & 1u) != 0)) {
+			return EIO;
+		}
+	}
+	ack = touch_bb_read_bit();
+	if (ack < 0) {
+		return EIO;
+	}
+	return ack == 0 ? 0 : ENXIO; /* 0 = ACK, 1 = NACK (nobody home) */
+}
+
+static int
+touch_bb_read_byte(uint8_t *out, bool last)
+{
+	uint8_t v = 0;
+
+	for (int i = 0; i < 8; ++i) {
+		int b = touch_bb_read_bit();
+		if (b < 0) {
+			return EIO;
+		}
+		v = (uint8_t)((v << 1) | (unsigned)b);
+	}
+	/* ACK every byte but the last (NACK = release SDA). */
+	if (!touch_bb_bit(last)) {
+		return EIO;
+	}
+	*out = v;
+	return 0;
+}
+
+/*
+ * One message. A stretched write (STOP_STRETCH) keeps SCL low and leaves the
+ * bus held; the following read picks it up with a repeated START, exactly like
+ * touch_read() expects.
+ */
+static int
+touch_bb_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	bool restarted = st.bb_hold;
+	int err = 0;
+
+	st.bb_hold = false;
+	if (nt > 3 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!touch_bb_start()) {
+		return EIO;
+	}
+	if (!restarted) {
+		err = touch_bb_write_byte((uint8_t)(((unsigned)addr << 1) |
+		    (rx ? 1u : 0u)));
+		if (err) {
+			goto out;
+		}
+		for (unsigned i = 0; rx == NULL && i < nt; ++i) {
+			err = touch_bb_write_byte(tx[i]);
+			if (err) {
+				goto out;
+			}
+		}
+		if (!rx) {
+			if (stretch) {
+				st.bb_hold = true;
+				return 0;
+			}
+			goto out;
+		}
+	} else {
+		/* repeated START after the pointer write */
+		err = touch_bb_write_byte((uint8_t)(((unsigned)addr << 1) | 1u));
+		if (err) {
+			goto out;
+		}
+	}
+	for (unsigned i = 0; i < nr; ++i) {
+		err = touch_bb_read_byte(&rx[i], i + 1u == nr);
+		if (err) {
+			goto out;
+		}
+	}
+out:
+	touch_bb_stop();
+	return err;
+}
