+/*
+ * WLAN translated-DMA interface.
+ *
+ * Ownership and lifetime checks are implemented here.
+ * No translated IOMMU domain is authorized yet.
+ *
+ * A later domain driver must install/verify the translation and
+ * perform required TLB maintenance before setting dma_addr.
+ */
+static int
+pm_do_wlan_dma_map(struct guac_wlan_dma_request *r)
+{
+    if (r->version != 1 || r->flags != 0 ||
+        r->dma_addr != 0 || !r->pa || !r->size)
+        return EINVAL;
+
+    if (r->pa >= 0x100000000ULL ||
+        r->size > 0x100000000ULL - r->pa)
+        return ERANGE;
+
+    for (int i = 0; i < PMEM_WLAN_MAX_ALLOCS; ++i) {
+        if (!pm_wlan_allocs[i].va ||
+            pm_wlan_allocs[i].pa != r->pa)
+            continue;
+
+        if (r->size > pm_wlan_allocs[i].size)
+            return EINVAL;
+
+        if (pm_wlan_allocs[i].dma_addr)
+            return EALREADY;
+
+        /*
+         * An owned allocation is not an installed IOVA mapping.
+         * No domain ownership or page-table backend exists yet.
+         */
+        return ENOTSUP;
+    }
+
+    return ENOENT;
+}
+
+static int
+pm_do_wlan_dma_unmap(uint64_t dma_addr)
+{
+    if (dma_addr < 0xa0000000ULL ||
+        dma_addr >= 0xb0000000ULL)
+        return EINVAL;
+
+    for (int i = 0; i < PMEM_WLAN_MAX_ALLOCS; ++i) {
+        if (pm_wlan_allocs[i].va &&
+            pm_wlan_allocs[i].dma_addr == dma_addr) {
+            /*
+             * Never clear ownership without successfully
+             * removing the device translation first.
+             */
+            return ENOTSUP;
+        }
+    }
+
     return ENOENT;
 }
 
