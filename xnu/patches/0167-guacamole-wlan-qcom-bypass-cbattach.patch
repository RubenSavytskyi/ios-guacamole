+            guac_last_smmu_snapshot.free_cb = selected_cb;
+            pm_wlan_verified = 1;
+        }
+        goto done;
+    }
     if (free_cb < 0) {
         /* Only diagnostic mode refines the reported errno. In every case,
          * return an error and refuse to program any SMMU registers or DMA. */
